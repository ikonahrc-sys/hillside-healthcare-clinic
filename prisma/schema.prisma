// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  users      User[]
  placements ClinicalPlacement[]

  referralsSent     Referral[]    @relation("ReferralFromDepartment")
  referralsReceived Referral[]    @relation("ReferralToDepartment")
  appointments      Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  placementsAsStudent    ClinicalPlacement[]    @relation("StudentPlacements")
  placementsAsSupervisor ClinicalPlacement[]    @relation("SupervisorPlacements")
  sessions               Session[]
  consultationsAsDoctor  Consultation[]         @relation("DoctorConsultations")
  referralsMade          Referral[]             @relation("ReferringUser")
  referralsResponded     Referral[]             @relation("RespondingUser")
  prescriptionsWritten   Prescription[]         @relation("PrescribingUser")
  appointmentsAsStaff    Appointment[]          @relation("StaffAppointments")
  inventoryTransactions  InventoryTransaction[]
  itemsDispensed         PrescriptionItem[]     @relation("DispensingUser")
  rehabAssessments       RehabAssessment[]      @relation("RehabAssessmentTherapist")
  rehabAssessmentsCoSigned RehabAssessment[]    @relation("RehabAssessmentCoSigner")
  rehabTreatmentPlans    RehabTreatmentPlan[]   @relation("RehabTreatmentPlanTherapist")
  rehabTreatmentPlansCoSigned RehabTreatmentPlan[] @relation("RehabTreatmentPlanCoSigner")
  therapySessions        TherapySession[]       @relation("TherapySessionTherapist")
  therapySessionsCoSigned TherapySession[]      @relation("TherapySessionCoSigner")
  homeNursingAssessments HomeNursingAssessment[] @relation("HomeNursingAssessmentNurse")
  homeNursingAssessmentsCoSigned HomeNursingAssessment[] @relation("HomeNursingAssessmentCoSigner")
  homeNursingCarePlans   HomeNursingCarePlan[]  @relation("HomeNursingCarePlanNurse")
  homeNursingCarePlansCoSigned HomeNursingCarePlan[] @relation("HomeNursingCarePlanCoSigner")
  homeVisits             HomeVisit[]            @relation("HomeVisitNurse")
  homeVisitsCoSigned     HomeVisit[]            @relation("HomeVisitCoSigner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PlacementStatus {
  UPCOMING
  ACTIVE
  EXPIRED
  SUSPENDED
  EXTENDED
}

model ClinicalPlacement {
  id           String  @id @default(cuid())
  clinicalArea String?

  studentId String
  student   User   @relation("StudentPlacements", fields: [studentId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  supervisorId String?
  supervisor   User?   @relation("SupervisorPlacements", fields: [supervisorId], references: [id])

  startDate DateTime
  endDate   DateTime
  status    PlacementStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([startDate, endDate])
}

model AuditLog {
  id String @id @default(cuid())

  // Snapshot, not a foreign key - must survive a user being deleted, and
  // must be able to record events with no authenticated actor at all
  // (e.g. a failed login attempt).
  actorId    String?
  actorEmail String?

  action     String
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id String @id @default(cuid())

  // Human-friendly record number, e.g. "P00001" (derived from mrnNumber in
  // application code). The Postgres autoincrement makes this race-safe
  // under concurrent registrations - "find the max and add 1" in app code
  // would not be.
  mrnNumber Int @unique @default(autoincrement())

  firstName   String
  lastName    String
  dateOfBirth DateTime
  sex         Sex

  address String?
  phone   String?
  email   String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Free-text for now. Structured allergy severity/reaction tracking is a
  // future enhancement, not needed for the first pass.
  allergies           String?
  medicalHistoryNotes String?

  consultations       Consultation[]
  diagnoses           Diagnosis[]
  referrals           Referral[]
  prescriptions       Prescription[]
  appointments        Appointment[]
  rehabAssessments       RehabAssessment[]
  rehabTreatmentPlans    RehabTreatmentPlan[]
  therapySessions        TherapySession[]
  homeNursingAssessments HomeNursingAssessment[]
  homeNursingCarePlans   HomeNursingCarePlan[]
  homeVisits             HomeVisit[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lastName, firstName])
}

model Consultation {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  doctor   User   @relation("DoctorConsultations", fields: [doctorId], references: [id])

  consultationDate DateTime @default(now())

  chiefComplaint          String
  historyOfPresentIllness String?
  examinationNotes        String?
  assessment              String?
  // Free text for now - a structured TreatmentPlan entity (goals,
  // frequency, review dates) waits until Rehabilitation actually needs
  // that structure in Phase 4, rather than building it speculatively now.
  treatmentNotes          String?
  notes                   String?

  vitals        VitalSigns?
  diagnoses     Diagnosis[]
  referrals     Referral[]
  prescriptions Prescription[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationDate])
}

model VitalSigns {
  id String @id @default(cuid())

  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  temperatureC            Float?
  heartRateBpm            Int?
  respiratoryRatePerMin   Int?
  bloodPressureSystolic   Int?
  bloodPressureDiastolic  Int?
  oxygenSaturationPercent Int?
  weightKg                Float?
  heightCm                Float?

  recordedAt DateTime @default(now())
}

model Diagnosis {
  id String @id @default(cuid())

  // Denormalized alongside consultationId - the patient's diagnosis
  // history (Overview tab, future Timeline) is a query we'll run
  // constantly, and this avoids joining through Consultation every time.
  // Set once at creation, never changes independently.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  description String
  isPrimary   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([consultationId])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
}

model Referral {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  fromDepartmentId String
  fromDepartment   Department @relation("ReferralFromDepartment", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("ReferralToDepartment", fields: [toDepartmentId], references: [id])

  referringUserId String
  referringUser   User   @relation("ReferringUser", fields: [referringUserId], references: [id])

  // Optional - not every referral has to originate from a documented
  // consultation, so this stays nullable rather than forced.
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  reason String
  status ReferralStatus @default(PENDING)

  respondedByUserId String?
  respondedByUser   User?     @relation("RespondingUser", fields: [respondedByUserId], references: [id])
  respondedAt       DateTime?
  responseNotes     String?

  rehabAssessments       RehabAssessment[]
  homeNursingAssessments HomeNursingAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([toDepartmentId, status])
  @@index([status])
}

model Medicine {
  id          String  @id @default(cuid())
  name        String
  genericName String?
  category    String?
  dosageForm  String
  strength    String?

  // Minimum total stock desired across all non-expired batches combined -
  // a property of the catalog entry, not of any one delivery/batch.
  reorderLevel Int?

  prescriptionItems PrescriptionItem[]
  batches           MedicineBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, strength, dosageForm])
  @@index([name])
}

enum PrescriptionStatus {
  PENDING
  PROCESSING
  DISPENSED
  CANCELLED
}

model Prescription {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  prescribedByUserId String
  prescribedByUser   User   @relation("PrescribingUser", fields: [prescribedByUserId], references: [id])

  status PrescriptionStatus @default(PENDING)
  notes  String?

  items PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status])
}

model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosageInstructions String
  quantity           Int

  // Null until dispensed. No partial-quantity or multi-batch splitting yet
  // (Phase 3 step 1's stated scope) - an item is either not dispensed at
  // all, or fully dispensed against exactly one batch.
  dispensedAt          DateTime?
  dispensedFromBatchId String?
  dispensedFromBatch   MedicineBatch? @relation(fields: [dispensedFromBatchId], references: [id])
  dispensedByUserId    String?
  dispensedByUser      User?          @relation("DispensingUser", fields: [dispensedByUserId], references: [id])

  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())

  @@index([prescriptionId])
}

enum AppointmentType {
  MEDICAL_FOLLOW_UP
  PHYSIOTHERAPY
  SPEECH_THERAPY
  OCCUPATIONAL_THERAPY
  HOME_NURSING_VISIT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Appointment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  staffId String
  staff   User   @relation("StaffAppointments", fields: [staffId], references: [id])

  type        AppointmentType
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, scheduledAt])
  @@index([patientId])
  @@index([staffId])
  @@index([status])
}

// One batch = one delivery of a specific medicine. quantityOnHand is a
// cache updated atomically alongside each InventoryTransaction insert -
// the transaction ledger below is the real source of truth and could
// always recompute this if it ever needed re-deriving.
model MedicineBatch {
  id String @id @default(cuid())

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  batchNumber    String
  expiryDate     DateTime
  quantityOnHand Int

  receivedAt DateTime @default(now())

  transactions   InventoryTransaction[]
  dispensedItems PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
}

enum InventoryTransactionType {
  RECEIVED
  DISPENSED
  ADJUSTED
  EXPIRED
}

model InventoryTransaction {
  id String @id @default(cuid())

  medicineBatchId String
  medicineBatch   MedicineBatch @relation(fields: [medicineBatchId], references: [id])

  type           InventoryTransactionType
  // Positive for RECEIVED, negative for DISPENSED/EXPIRED/downward ADJUSTED.
  quantityChange Int

  performedByUserId String
  performedByUser   User   @relation(fields: [performedByUserId], references: [id])

  // Links a DISPENSED transaction back to the specific prescription item
  // it fulfilled - the traceability the ledger design exists for.
  relatedPrescriptionItemId String?
  relatedPrescriptionItem   PrescriptionItem? @relation(fields: [relatedPrescriptionItemId], references: [id])

  notes String?

  createdAt DateTime @default(now())

  @@index([medicineBatchId])
  @@index([createdAt])
}

// Rehabilitation is one department; these are disciplines within it, not
// separate departments - a referral goes to Rehabilitation generally and
// gets triaged to a discipline at assessment time.
enum RehabDiscipline {
  PHYSIOTHERAPY
  SPEECH_THERAPY
  OCCUPATIONAL_THERAPY
}

model RehabAssessment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Optional - an assessment doesn't have to trace back to a specific
  // referral (e.g. a therapist picking up a patient already known to the
  // department), but usually will.
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])

  therapistId String
  therapist   User   @relation("RehabAssessmentTherapist", fields: [therapistId], references: [id])

  // Set when a STUDENT authors this assessment during an active
  // placement (see authorizeClinicalAuthor in lib/auth/clinical-author.ts).
  // Null for a normal staff-authored record, which never needs a co-sign
  // at all - "pending co-sign" is therefore
  // therapist.role === STUDENT && coSignedAt === null, not a separate
  // stored flag that could drift out of sync.
  coSignedByUserId String?
  coSignedBy       User?     @relation("RehabAssessmentCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  discipline RehabDiscipline

  findings              String
  functionalLimitations String?
  goals                 String?
  precautions           String?
  notes                 String?

  treatmentPlan RehabTreatmentPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([therapistId])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

// The structured entity Consultation's free-text treatmentNotes
// deliberately deferred twice in Phase 2 - Rehab actually needs goals,
// frequency, and a review date that persist and get revisited across
// many sessions, not a one-time note attached to a single visit.
model RehabTreatmentPlan {
  id String @id @default(cuid())

  assessmentId String          @unique
  assessment   RehabAssessment @relation(fields: [assessmentId], references: [id])

  // Denormalized alongside assessmentId, same reasoning as Diagnosis.
  // patientId - the patient's Rehab history is a query the Timeline and
  // Rehabilitation tab will run constantly.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  therapistId String
  therapist   User   @relation("RehabTreatmentPlanTherapist", fields: [therapistId], references: [id])

  // Same co-sign shape as RehabAssessment.coSignedByUserId/coSignedAt -
  // see the comment there.
  coSignedByUserId String?
  coSignedBy       User?     @relation("RehabTreatmentPlanCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  goals       String
  frequency   String
  reviewDate  DateTime?
  precautions String?
  status      TreatmentPlanStatus @default(ACTIVE)

  therapySessions TherapySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([therapistId])
}

// A single logged visit against an active treatment plan - what Consultation
// is to a Medical visit. Deliberately not linked to a specific Appointment
// row, same reasoning as Consultation/Appointment: the appointment is just
// scheduling, this is the clinical record of what actually happened.
model TherapySession {
  id String @id @default(cuid())

  treatmentPlanId String
  treatmentPlan   RehabTreatmentPlan @relation(fields: [treatmentPlanId], references: [id])

  // Denormalized, same reasoning as RehabTreatmentPlan.patientId.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  therapistId String
  therapist   User   @relation("TherapySessionTherapist", fields: [therapistId], references: [id])

  // Same co-sign shape as RehabAssessment.coSignedByUserId/coSignedAt -
  // see the comment there.
  coSignedByUserId String?
  coSignedBy       User?     @relation("TherapySessionCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  sessionDate DateTime @default(now())

  activities String
  progress   String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentPlanId])
  @@index([patientId])
  @@index([therapistId])
}

// Home Nursing follows the same shape as Rehab: an initial assessment,
// then a care plan, then (in a later step) logged visits against that
// plan - a nurse's home visit is not fundamentally different in structure
// from a therapist's, just different content.
model HomeNursingAssessment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Optional, same reasoning as RehabAssessment.referralId.
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])

  nurseId String
  nurse   User   @relation("HomeNursingAssessmentNurse", fields: [nurseId], references: [id])

  // Same co-sign shape as RehabAssessment.coSignedByUserId/coSignedAt -
  // see the comment there.
  coSignedByUserId String?
  coSignedBy       User?     @relation("HomeNursingAssessmentCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  findings    String
  careNeeds   String?
  precautions String?
  notes       String?

  carePlan HomeNursingCarePlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([nurseId])
}

model HomeNursingCarePlan {
  id String @id @default(cuid())

  assessmentId String                @unique
  assessment   HomeNursingAssessment @relation(fields: [assessmentId], references: [id])

  // Denormalized, same reasoning as RehabTreatmentPlan.patientId.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  nurseId String
  nurse   User   @relation("HomeNursingCarePlanNurse", fields: [nurseId], references: [id])

  // Same co-sign shape as RehabAssessment.coSignedByUserId/coSignedAt -
  // see the comment there.
  coSignedByUserId String?
  coSignedBy       User?     @relation("HomeNursingCarePlanCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  goals       String
  frequency   String
  reviewDate  DateTime?
  precautions String?
  // Reusing TreatmentPlanStatus - a care plan's lifecycle (active,
  // completed, discontinued) is identical to a rehab treatment plan's,
  // no separate enum needed for the same three states.
  status TreatmentPlanStatus @default(ACTIVE)

  homeVisits HomeVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([nurseId])
}

// A single logged home visit against an active care plan - the Home
// Nursing equivalent of TherapySession. Deliberately not linked to a
// specific Appointment row, same reasoning as TherapySession/Appointment.
model HomeVisit {
  id String @id @default(cuid())

  carePlanId String
  carePlan   HomeNursingCarePlan @relation(fields: [carePlanId], references: [id])

  // Denormalized, same reasoning as HomeNursingCarePlan.patientId.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  nurseId String
  nurse   User   @relation("HomeVisitNurse", fields: [nurseId], references: [id])

  // Same co-sign shape as RehabAssessment.coSignedByUserId/coSignedAt -
  // see the comment there.
  coSignedByUserId String?
  coSignedBy       User?     @relation("HomeVisitCoSigner", fields: [coSignedByUserId], references: [id])
  coSignedAt       DateTime?

  visitDate DateTime @default(now())

  careProvided     String
  patientCondition String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carePlanId])
  @@index([patientId])
  @@index([nurseId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  users      User[]
  placements ClinicalPlacement[]

  referralsSent     Referral[] @relation("ReferralFromDepartment")
  referralsReceived Referral[] @relation("ReferralToDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  placementsAsStudent    ClinicalPlacement[] @relation("StudentPlacements")
  placementsAsSupervisor ClinicalPlacement[] @relation("SupervisorPlacements")
  sessions               Session[]
  consultationsAsDoctor  Consultation[]      @relation("DoctorConsultations")
  referralsMade          Referral[]          @relation("ReferringUser")
  referralsResponded     Referral[]          @relation("RespondingUser")
  prescriptionsWritten   Prescription[]      @relation("PrescribingUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PlacementStatus {
  UPCOMING
  ACTIVE
  EXPIRED
  SUSPENDED
  EXTENDED
}

model ClinicalPlacement {
  id           String  @id @default(cuid())
  clinicalArea String?

  studentId String
  student   User   @relation("StudentPlacements", fields: [studentId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  supervisorId String?
  supervisor   User?   @relation("SupervisorPlacements", fields: [supervisorId], references: [id])

  startDate DateTime
  endDate   DateTime
  status    PlacementStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([startDate, endDate])
}

model AuditLog {
  id String @id @default(cuid())

  // Snapshot, not a foreign key - must survive a user being deleted, and
  // must be able to record events with no authenticated actor at all
  // (e.g. a failed login attempt).
  actorId    String?
  actorEmail String?

  action     String
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id String @id @default(cuid())

  // Human-friendly record number, e.g. "P00001" (derived from mrnNumber in
  // application code). The Postgres autoincrement makes this race-safe
  // under concurrent registrations - "find the max and add 1" in app code
  // would not be.
  mrnNumber Int @unique @default(autoincrement())

  firstName   String
  lastName    String
  dateOfBirth DateTime
  sex         Sex

  address String?
  phone   String?
  email   String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Free-text for now. Structured allergy severity/reaction tracking is a
  // future enhancement, not needed for the first pass.
  allergies           String?
  medicalHistoryNotes String?

  consultations Consultation[]
  diagnoses     Diagnosis[]
  referrals     Referral[]
  prescriptions Prescription[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lastName, firstName])
}

model Consultation {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  doctor   User   @relation("DoctorConsultations", fields: [doctorId], references: [id])

  consultationDate DateTime @default(now())

  chiefComplaint          String
  historyOfPresentIllness String?
  examinationNotes        String?
  assessment              String?
  // Free text for now - a structured TreatmentPlan entity (goals,
  // frequency, review dates) waits until Rehabilitation actually needs
  // that structure in Phase 4, rather than building it speculatively now.
  treatmentNotes          String?
  notes                   String?

  vitals        VitalSigns?
  diagnoses     Diagnosis[]
  referrals     Referral[]
  prescriptions Prescription[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationDate])
}

model VitalSigns {
  id String @id @default(cuid())

  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  temperatureC            Float?
  heartRateBpm            Int?
  respiratoryRatePerMin   Int?
  bloodPressureSystolic   Int?
  bloodPressureDiastolic  Int?
  oxygenSaturationPercent Int?
  weightKg                Float?
  heightCm                Float?

  recordedAt DateTime @default(now())
}

model Diagnosis {
  id String @id @default(cuid())

  // Denormalized alongside consultationId - the patient's diagnosis
  // history (Overview tab, future Timeline) is a query we'll run
  // constantly, and this avoids joining through Consultation every time.
  // Set once at creation, never changes independently.
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  description String
  isPrimary   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([consultationId])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
}

model Referral {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  fromDepartmentId String
  fromDepartment   Department @relation("ReferralFromDepartment", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("ReferralToDepartment", fields: [toDepartmentId], references: [id])

  referringUserId String
  referringUser   User   @relation("ReferringUser", fields: [referringUserId], references: [id])

  // Optional - not every referral has to originate from a documented
  // consultation, so this stays nullable rather than forced.
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  reason String
  status ReferralStatus @default(PENDING)

  respondedByUserId String?
  respondedByUser   User?     @relation("RespondingUser", fields: [respondedByUserId], references: [id])
  respondedAt       DateTime?
  responseNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([toDepartmentId, status])
  @@index([status])
}

// No stock, batches, or expiry tracking here - that's Phase 3 (Pharmacy)
// territory, which needs inventory transactions and a real dispensing
// workflow this table doesn't attempt to support yet. This is just a
// catalog doctors can select from when writing a prescription.
model Medicine {
  id          String  @id @default(cuid())
  name        String
  genericName String?
  category    String?
  dosageForm  String
  strength    String?

  prescriptionItems PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, strength, dosageForm])
  @@index([name])
}

enum PrescriptionStatus {
  PENDING
  PROCESSING
  DISPENSED
  CANCELLED
}

model Prescription {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  prescribedByUserId String
  prescribedByUser   User   @relation("PrescribingUser", fields: [prescribedByUserId], references: [id])

  status PrescriptionStatus @default(PENDING)
  notes  String?

  items PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status])
}

model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosageInstructions String
  quantity           Int

  createdAt DateTime @default(now())

  @@index([prescriptionId])
}
